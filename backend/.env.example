# Copy this file to .env (next to manage.py).
# Real environment variables always override values in this file.

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=False

# Origin of the React app (Stripe sends customers back here)
FRONTEND_URL=http://localhost:3000

# --- Database ---
# sqlite = zero setup (db.sqlite3 next to manage.py); postgres is the default.
# For PostgreSQL set DB_ENGINE=postgres, choose a DB_PASSWORD (there is no built-in
# one) and run `python manage.py create_dev_database` once: it creates the role
# and the database below and asks for the password of the postgres superuser.
DB_ENGINE=sqlite
# SQLITE_NAME=db.sqlite3
# DB_NAME=coursera_db
# DB_USER=coursera_admin
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- Development data ---
# Password of the users created by `python manage.py seed_dev`; random (and
# printed once) when empty.  Set it to keep the same password across resets.
# SEED_PASSWORD=

# --- WebSockets ---
# Needed only when the API and the socket consumers run in different processes
# REDIS_URL=redis://localhost:6379/0

# --- Stripe (use test-mode keys) ---
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_ACCOUNT_ID=
# STRIPE_WEBHOOK_SECRET=
