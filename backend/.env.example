# Copy this file to .env (next to manage.py).
# Real environment variables always override values in this file.

# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOW_ALL_ORIGINS=False

# Origin of the React app (Stripe sends customers back here)
FRONTEND_URL=http://localhost:3000

# --- Database ---
# sqlite = zero setup (db.sqlite3 next to manage.py); postgres is the default
DB_ENGINE=sqlite
# SQLITE_NAME=db.sqlite3
# DB_NAME=coursera_db
# DB_USER=coursera_admin
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- WebSockets ---
# Needed only when the API and the socket consumers run in different processes
# REDIS_URL=redis://localhost:6379/0

# --- Stripe (use test-mode keys) ---
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_ACCOUNT_ID=
# STRIPE_WEBHOOK_SECRET=
