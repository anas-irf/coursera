# Copy this file to .env (next to manage.py).
# Real environment variables always override values in this file.
#
# Local development needs none of it: config.settings.dev supplies safe defaults.
# A deployment runs config.settings.prod (the default of wsgi.py and asgi.py) and
# refuses to start without the variables marked "required in production".

# --- Django ---
# Required in production: a long random string, never the value below, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
# Development: on by default.  Production: off by default, keep it off.
DEBUG=True
# Required in production: the host names the site is served from, comma separated
ALLOWED_HOSTS=localhost,127.0.0.1
# Required in production: the origins of the React app, comma separated
# (development defaults to http://localhost:3000 and http://127.0.0.1:3000)
# CORS_ALLOWED_ORIGINS=https://app.example.com
# Never true in production
CORS_ALLOW_ALL_ORIGINS=False

# Origin of the React app (Stripe sends customers back here); required in production
FRONTEND_URL=http://localhost:3000

# --- Database ---
# sqlite = zero setup (db.sqlite3 next to manage.py); postgres is the default.
# For PostgreSQL set DB_ENGINE=postgres, choose a DB_PASSWORD (there is no built-in
# one) and run `python manage.py create_dev_database` once: it creates the role
# and the database below and asks for the password of the postgres superuser.
# DB_PASSWORD is required in production for PostgreSQL.
DB_ENGINE=sqlite
# SQLITE_NAME=db.sqlite3
# DB_NAME=coursera_db
# DB_USER=coursera_admin
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- Tests ---
# The suite runs on SQLite; TEST_DB_ENGINE=postgres runs it on the DB_* connection above
# (the role needs CREATEDB: Django creates a test_<DB_NAME> database).
# TEST_DB_ENGINE=sqlite

# --- Quizzes ---
# Seconds a quiz answer may arrive after the time limit (network delay, clock skew)
# before the attempt is closed with a score of zero.
# QUIZ_SUBMIT_GRACE_SECONDS=30

# --- Certificates ---
# Weighted grade (percent) of a course that earns a certificate once it is completed.
# COURSE_PASSING_GRADE=60

# --- Instructor earnings ---
# Share (percent) of the month's Coursera Plus payments that is shared among the instructors.
# Calculated by `python manage.py calculate_earnings` (once, after the month ended).
# INSTRUCTOR_REVENUE_SHARE_PERCENT=40

# --- Development data ---
# Password of the users created by `python manage.py seed_dev`; random (and
# printed once) when empty.  Set it to keep the same password across resets.
# SEED_PASSWORD=

# --- WebSockets ---
# Needed only when the API and the socket consumers run in different processes.
# Required in production unless CHANNEL_LAYER=memory (a single process only).
# REDIS_URL=redis://localhost:6379/0
# CHANNEL_LAYER=memory

# --- API versions ---
# The API lives at /api/v1/.  The unversioned /api/<slice>/ paths of the first release
# stay as deprecated aliases (Deprecation and Link headers) until this is switched off.
# API_LEGACY_ALIASES=True
# HTTP date announced to clients in the Sunset header of the aliases
# API_LEGACY_SUNSET=

# --- Throttling ---
# Rates are DRF's "number/period" (second, minute, hour, day).  Counters live in the
# cache: with REDIS_URL set every worker shares them.
# THROTTLE_ANON=120/min
# THROTTLE_USER=1200/min
# THROTTLE_LOGIN=10/min
# THROTTLE_SIGNUP=10/hour
# THROTTLE_REFRESH=60/min
# THROTTLE_MESSAGES=60/min
# THROTTLE_UPLOADS=30/min
# THROTTLE_PROGRESS=120/min
# How many proxies sit in front of the app (0 = none): the client address is the
# matching X-Forwarded-For hop.  Never raise it above the real number.
# NUM_PROXIES=0

# --- Session cookies ---
# The browser keeps its JWT pair in HttpOnly cookies.  The app and the API must be on one site
# (localhost for both in development; app. and api. of one domain in production), and the
# app's origin must be in CORS_ALLOWED_ORIGINS: cookie requests that change data are only
# accepted from there.  Secure is always on in production.
# AUTH_COOKIE_ACCESS=coursera_access
# AUTH_COOKIE_REFRESH=coursera_refresh
# AUTH_COOKIE_SECURE=False
# AUTH_COOKIE_SAMESITE=Lax
# AUTH_COOKIE_DOMAIN=
# Keep the token pair in login answers and accept the refresh token in a body (the front end
# before cookies, scripts).  Set it to False once nothing of that is left.
# AUTH_LEGACY_TOKEN_TRANSPORT=True

# --- Tokens ---
# JWT_ACCESS_LIFETIME_MINUTES=60
# JWT_REFRESH_LIFETIME_DAYS=7

# --- Logging ---
# Level of the application's own loggers; everything goes to the console
# LOG_LEVEL=INFO

# --- Production only ---
# Set when a TLS terminating proxy sits in front of the app, so its
# X-Forwarded-Proto header is trusted.  Never set it without such a proxy.
# BEHIND_TLS_PROXY=True

# --- Stripe (use test-mode keys) ---
# Checkout needs STRIPE_SECRET_KEY: there is no default, keep it in your own .env.
# With STRIPE_SECRET_KEY set, STRIPE_WEBHOOK_SECRET is required in production, and the webhook
# refuses every request (503) while it is empty: locally, `stripe listen` prints the secret.
# Subscribe the endpoint (/api/payments/stripe/webhook/) to checkout.session.completed,
# invoice.payment_succeeded, invoice.payment_failed, customer.subscription.updated and
# customer.subscription.deleted.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
